# auth service. Copy to .env and fill in real values: cp .env.example .env
APP_ENV=development
AUTH_HTTP_ADDR=:8081

# postgres
AUTH_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/auth?sslmode=disable

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_POOL_SIZE=20
REDIS_MAX_IDLE_CONNS=10
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=5s

# http server
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
